{
  "name": "vanabrowser",
  "version": "0.1.0",
  "description": "VanaBROWSer — desktop Chromium browser",
  "main": "main.js",
  "author": "VanaBROWSer",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "pre-dist": "node scripts/create-icon.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.vanabrowser.desktop",
    "productName": "VanaBROWSer",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json",
      "assets/icon.svg"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    }
  }
}
